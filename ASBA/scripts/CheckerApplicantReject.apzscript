// ==============================
// CHECKER - APPLICANT REJECTED PAGE
// Screen: CheckerApplicantReject | Layout: NewLayout
// Paints the decided request snapshot (apz.app.checkerDecision)
// written by the Reject action (remarks mandatory there).
// All element IDs below are design IDs - do NOT rename them here.
// ==============================

// DOM id prefix for every element on this screen.
const CAR_P = "ASBA__CheckerApplicantReject__";

apz.app.CheckerApplicantReject = {
};


// ==============================
// ONLOAD - paints the rejected request snapshot.
// ==============================

apz.app.onLoad_CheckerApplicantReject = () => {

    // Static sample so the page shows data even when opened
    // directly (no Accept/Reject ran yet in this session).
    let req = apz.app.checkerDecision || {
        requestId: "ASBA-20250813-100002",
        initiatedDateTime: "13-08-2025 11:30:00",
        decidedOn: "13-08-2025 12:00:00",
        nickname: "VINO",
        applicantName: "Vino Kumar",
        pan: "BCDEF2345G",
        depositoryType: "CDSL",
        dpId: "",
        clientId: "87654321",
        priority: "Medium",
        remarks: "PAN mismatch"
    };

    let paint = (id, value) => {
        let elm = document.getElementById(CAR_P + id);
        if (elm) {
            elm.textContent = (value === undefined || value === null) ? "" : String(value);
        }
    };

    // Request ID / Decided Date & Time.
    paint("el_txt_4_txtcnt", req.requestId);
    paint("el_txt_8_txtcnt", req.decidedOn || req.initiatedDateTime);

    // Applicant ID (none on record) / Nickname / Applicant Name.
    paint("el_txt_11_txtcnt", "");
    paint("el_txt_13_txtcnt", req.nickname);
    paint("el_txt_15_txtcnt", req.applicantName);

    // Depository Type / DP ID / Client ID.
    paint("el_txt_17_txtcnt", req.depositoryType);
    paint("el_txt_19_txtcnt", req.dpId);
    paint("el_txt_21_txtcnt", req.clientId);

    // PAN.
    paint("el_txt_23_txtcnt", req.pan);

    // Bid row + block (present when an IPO request was rejected;
    // applicant requests leave these blank by design).
    let bids = req.bids || [];
    let firstBid = bids.length ? bids[0] : {};

    paint("el_txt_33_txtcnt", firstBid.no);
    paint("el_txt_34_txtcnt", firstBid.quantity);
    paint("el_txt_35_txtcnt", firstBid.price);
    paint("el_txt_36_txtcnt", firstBid.amount);
    paint("el_txt_38_txtcnt", req.blockAmount);
    paint("el_txt_39_txtcnt", req.blockAmount);

    // Priority.
    paint("el_txt_42_txtcnt", req.priority);
};
