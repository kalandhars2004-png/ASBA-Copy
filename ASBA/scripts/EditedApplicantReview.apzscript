// ==============================
// EDITED APPLICANT REVIEW
// Screen: EditedApplicantReview | Layout: NewLayout
// All element IDs below are design IDs - do NOT rename them here.
// To change an ID, change it in the designer (D0.apzlayoutdesign)
// and rebuild; script-only changes must reuse the same IDs.
// ==============================

// DOM id prefix for every element on this screen.
const EAR_P = "ASBA__EditedApplicantReview__";

apz.app.EditedApplicantReview = {

    // Back to the edit form. Edited values stay in
    // apz.app.editData for re-paint on return.
    Cancel: () => {
        apz.launchScreen({ appId: apz.appId, scr: "EditApplicant" });
    },

    // Moves to the edit success screen.
    Continue: () => {
        apz.launchScreen({ appId: apz.appId, scr: "EditApplicantSuccess" });
    }
};


// ==============================
// ONLOAD - paints the edited values from apz.app.editData.
// Cell order matches the design labels:
// Applicant ID / Nickname / Applicant Name, then
// Depository Type / DP ID / Client ID, then PAN,
// then Request ID / Approved Date, then Priority.
// ==============================

apz.app.onLoad_EditedApplicantReview = () => {

    let data = apz.app.editData;

    if (!data) {
        return;
    }

    let paint = (id, value) => {
        let elm = document.getElementById(EAR_P + id);
        if (elm) {
            elm.textContent = (value === undefined || value === null) ? "" : String(value);
        }
    };

    // Request ID / Approved Date & Time.
    paint("el_txt_40_txtcnt", data.requestId);
    paint("el_txt_42_txtcnt", data.approvedDateTime);

    // Applicant ID / Nickname / Applicant Name.
    paint("el_txt_20_txtcnt", data.applicantId);
    paint("el_txt_21_txtcnt", data.nickname);
    paint("el_txt_22_txtcnt", data.applicantName);

    // Depository Type / DP ID / Client ID.
    paint("el_txt_23_txtcnt", data.depositoryType);
    paint("el_txt_24_txtcnt", data.dpId);
    paint("el_txt_25_txtcnt", data.clientId);

    // PAN.
    paint("el_txt_26_txtcnt", data.pan);

    // Priority.
    paint("el_txt_32_txtcnt", data.priority);
};
