// ==============================
// WITHDRAW SUCCESS
// Screen: WithdrawSuccess | Layout: NewLayout
// Paints the request frozen by ConfirmWithdraw. Applicant
// cells stay blank: the Withdraw entry carries an application
// record (no applicant fields), so applicant context must be
// added to the entry before these can paint (see report).
// All element IDs below are design IDs - do NOT rename them here.
// ==============================

// DOM id prefix for every element on this screen.
const WDS_P = "ASBA__WithdrawSuccess__";

apz.app.WithdrawSuccess = {

    // Back to the dashboard (flow ends here).
    Dashboard: () => {
        apz.launchScreen({ appId: apz.appId, scr: "dashboard" });
    }
};


// ==============================
// ONLOAD - paints the withdraw request.
// ==============================

apz.app.onLoad_WithdrawSuccess = () => {

    let wd = apz.app.withdrawData || {};

    let paint = (id, value) => {
        let elm = document.getElementById(WDS_P + id);
        if (elm) {
            elm.textContent = (value === undefined || value === null) ? "" : String(value);
        }
    };

    // Request ID / Initiated Date & Time.
    paint("el_txt_21_txtcnt", wd.requestId);
    paint("el_txt_23_txtcnt", wd.initiatedDateTime);
};
