// ==============================
// ADD APPLICANT + DEMAT
// Screen: AddApplicantAndDemat | Layout: NewLayout
// All element IDs below are design IDs - do NOT rename them here.
// To change an ID, change it in the designer (D0.apzlayoutdesign)
// and rebuild; script-only changes must reuse the same IDs.
// ==============================

// Element IDs come from window.Constants (see Constants.apzscript).

// Fallback ID if Constants.js failed to load (stale or
// partial deploy serves mismatched files). Real Constants
// overwrites this when it loads; harmless when it ran first.
var Constants = window.Constants || {};
Constants.ID_ADD_APPLICANT = Constants.ID_ADD_APPLICANT || "ASBA__AddApplicantAndDemat__";

apz.app.AddApplicantAndDemat = {

    // Discards the form and returns to the dashboard.
    Cancel: () => {
        apz.launchScreen({ appId: apz.appId, scr: "dashboard" });
    },

    // Validates the form, stores it globally for the Review and
    // Success screens, then moves to AddApplicantReviewAndConfirm.
    Continue: () => {
        let nickname = apz.getElmValue(Constants.ID_ADD_APPLICANT + "el_txa_2");
        let pan = apz.getElmValue(Constants.ID_ADD_APPLICANT + "el_txa_3");
        let dpId = apz.getElmValue(Constants.ID_ADD_APPLICANT + "el_txa_4");
        let applicantName = apz.getElmValue(Constants.ID_ADD_APPLICANT + "el_txa_5");
        let clientId = apz.getElmValue(Constants.ID_ADD_APPLICANT + "el_txa_7");

        // Get selected Depository Type (NSDL / CDSL radio).
        let selectedRadio = document.querySelector(
            'input[name="' + Constants.ID_ADD_APPLICANT + 'el_txa_6_"]:checked'
        );

        let depositoryType = "";

        if (selectedRadio) {
            depositoryType = selectedRadio.getAttribute("aria-label") || "";
        }

        // Priority dropdown: read the visible input value directly.
        // apz.getElmValue returns "" here unless an option was
        // explicitly picked (platform only reads li.is-selected),
        // while the input always shows the current selection
        // (default "High" from the design).
        let priorityElm = document.getElementById(Constants.ID_ADD_APPLICANT + "el_dpd_1");
        let priority = (priorityElm && priorityElm.value) ||
            apz.getElmValue(Constants.ID_ADD_APPLICANT + "el_dpd_1");

        let declarationElm = document.getElementById(Constants.ID_ADD_APPLICANT + "el_cbx_1");
        let declaration = declarationElm ? !!declarationElm.checked : false;

        // Mandatory check before leaving the screen.
        if (!nickname || !applicantName || !pan) {
            apz.dispMsg({
                type: "E",
                message: "Nickname, Applicant Name and PAN are mandatory"
            });
            return;
        }

        // Shared with Review (paint) and Success (paint + request id).
        apz.app.applicationData = {
            nickname: nickname,
            pan: pan,
            dpId: dpId,
            applicantName: applicantName,
            clientId: clientId,
            depositoryType: depositoryType,
            priority: priority,
            declaration: declaration
        };

        console.log("Application Data :", apz.app.applicationData);

        // All review landings go through the common page.
        // reviewFrom tells it which div to show + paint.
        apz.app.reviewFrom = "AddApplicantReviewAndConfirm";

        apz.launchScreen({ appId: apz.appId, scr: "CommonReviewPage" });
    },

    // Recent-applicants list response (painted by the framework).
    recentApplicationCB: (resp) => {
        if (resp.errors) {
            apz.dispMsg({
                type: "E",
                message: resp.errors[0].errorMessage
            });
            return;
        }
    }
};


// ==============================
// ONLOAD
// Loads the recent-applicants list painted on this screen.
// ==============================

apz.app.onLoad_AddApplicantAndDemat = () => {

    apz.server.callServer({
        appId: apz.appId,
        ifaceName: "recentapplication",
        buildReq: "N",
        paintResp: "Y",
        req: {},
        callBack: apz.app.AddApplicantAndDemat.recentApplicationCB
    });

};
