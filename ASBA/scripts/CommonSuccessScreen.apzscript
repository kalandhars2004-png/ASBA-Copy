// ==============================
// COMMON SUCCESS SCREEN
// Screen: CommonSuccessScreen | Layout: NewLayout
// Single landing page for all success flows. Each Review
// confirm sets apz.app.successFrom to its screen name; onLoad
// shows only the matching div + footer and paints it.
// Flows WITHOUT a div here keep their own pages.
// Divs (all top-level siblings): ASBARegistrationDiv /
// AddApplicantDiv / AppyForIPODiv / WithdrawDiv /
// EditSuccessDiv / CheckerIPOsuccespageDiv /
// CheckerAddapplicantSuccesspageDiv + matching footers.
// Shared header (el_txt_218/220) paints Request ID / Date
// where the flow provides them.
// All element IDs below are design IDs - do NOT rename them here.
// ==============================

// Element IDs come from window.Constants (see Constants.apzscript).

// Fallback ID if Constants.js failed to load (stale or
// partial deploy serves mismatched files). Real Constants
// overwrites this when it loads; harmless when it ran first.
var Constants = window.Constants || {};
Constants.ID_COMMON_SUCCESS = Constants.ID_COMMON_SUCCESS || "ASBA__CommonSuccessScreen__";

apz.app.CommonSuccessScreen = {

    // Back to the dashboard (flow ends here).
    Dashboard: () => {
        apz.launchScreen({ appId: apz.appId, scr: "dashboard" });
    },

    // Starts a fresh form. Registration flow returns to the
    // Register form, every other flow to Add Applicant + Demat.
    AddNewApplicant: () => {
        let from = apz.app.successFrom || "";

        if (from === "RegistrationReviewandConfirm") {
            apz.launchScreen({ appId: apz.appId, scr: "RegisterApplicant" });
        } else {
            apz.launchScreen({ appId: apz.appId, scr: "AddApplicantAndDemat" });
        }
    },

    // Starts a fresh IPO application.
    ApplyNewIPO: () => {
        apz.launchScreen({ appId: apz.appId, scr: "ApplyPage" });
    },

    // Back to the Withdraw screen for another withdrawal.
    WithdrawAgain: () => {
        apz.launchScreen({ appId: apz.appId, scr: "Withdraw" });
    },

    // Shows only the given divs. All content + footer divs are
    // top-level siblings - no ancestor handling needed.
    // NOTE: keep this list in sync if the designer restructures.
    showOnly: (...ids) => {
        let divs = [
            "ASBARegistrationDiv", "ASBARegistrationFooterDiv",
            "AddApplicantDiv", "AddApplicantFooterDiv",
            "AppyForIPODiv", "AppyForIPOFooterDiv",
            "WithdrawDiv", "WithdrawFooterDiv",
            "EditSuccessDiv", "EditSuccessFooterDiv",
            "CheckerIPOsuccespageDiv", "CheckerIPOsuccespageFooterDiv",
            "CheckerAddapplicantSuccesspageDiv", "CheckerAddapplicantSuccesspageFooterDiv"
        ];

        divs.forEach((name) => {
            let elm = document.getElementById(Constants.ID_COMMON_SUCCESS + name);

            if (!elm) {
                return;
            }

            if (ids.indexOf(name) >= 0) {
                apz.show(Constants.ID_COMMON_SUCCESS + name);
            } else {
                apz.hide(Constants.ID_COMMON_SUCCESS + name);
            }
        });
    }
};


// ==============================
// ONLOAD - shows + paints the div matching apz.app.successFrom.
// ==============================

apz.app.onLoad_CommonSuccessScreen = () => {

    let from = apz.app.successFrom || "";

    let paint = (id, value) => {
        let elm = document.getElementById(Constants.ID_COMMON_SUCCESS + id);
        if (elm) {
            elm.textContent = (value === undefined || value === null) ? "" : String(value);
        }
    };

    if (from === "RegistrationReviewandConfirm") {
        let data = apz.app.registrationData || {};

        apz.app.CommonSuccessScreen.showOnly("ASBARegistrationDiv", "ASBARegistrationFooterDiv");

        // Nickname / Applicant Name / CIF ID.
        paint("el_txt_199_txtcnt", data.nickname);
        paint("el_txt_200_txtcnt", data.applicantName);
        paint("el_txt_201_txtcnt", data.cifId || data.clientId);

        // Corporate ID / Corporate Name / PAN.
        paint("el_txt_205_txtcnt", data.corporateId);
        paint("el_txt_206_txtcnt", data.corporateName);
        paint("el_txt_207_txtcnt", data.pan);

        // Depository Type / DP ID / Client ID.
        paint("el_txt_211_txtcnt", data.depositoryType);
        paint("el_txt_212_txtcnt", data.dpId);
        paint("el_txt_213_txtcnt", data.clientId);

        // Priority.
        paint("el_txt_216_txtcnt", data.priority);
    } else if (from === "AddApplicantReviewAndConfirm") {
        let data = apz.app.applicationData || {};

        apz.app.CommonSuccessScreen.showOnly("AddApplicantDiv", "AddApplicantFooterDiv");

        // Shared header: Request ID / Initiated Date & Time.
        paint("el_txt_218_txtcnt", data.requestId);
        paint("el_txt_220_txtcnt", data.initiatedDateTime);

        // Nickname / Applicant Name / CIF ID.
        paint("el_txt_225_txtcnt", data.nickname);
        paint("el_txt_226_txtcnt", data.applicantName);
        paint("el_txt_227_txtcnt", data.clientId);

        // Depository Type / DP ID / Client ID.
        paint("el_txt_231_txtcnt", data.depositoryType);
        paint("el_txt_232_txtcnt", data.dpId);
        paint("el_txt_233_txtcnt", data.clientId);

        // Priority.
        paint("el_txt_236_txtcnt", data.priority);
    } else if (from === "ApplyReview") {
        let picked = apz.app.applyApplicant || {};
        let apply = apz.app.applyData || {};
        let bids = apz.app.bidRows || [];
        let firstBid = bids.length ? bids[0] : {};

        apz.app.CommonSuccessScreen.showOnly("AppyForIPODiv", "AppyForIPOFooterDiv");

        // Shared header: Request ID / Initiated Date & Time.
        paint("el_txt_218_txtcnt", apply.requestId);
        paint("el_txt_220_txtcnt", apply.initiatedDateTime);

        // Nickname + first bid (No cell omitted by design -
        // quantity / price / amount only).
        paint("el_txt_240_txtcnt", picked.nickname || applicant.applicantName);
        paint("el_txt_241_txtcnt", firstBid.quantity);
        paint("el_txt_242_txtcnt", firstBid.price);
        paint("el_txt_243_txtcnt", firstBid.amount);

        // Block Amount: sum of parseable bid amounts, else first
        // amount, else blank (local rule - no cross-screen call).
        let blockAmount = "";
        {
            let total = 0;
            let parsed = 0;

            bids.forEach((bid) => {
                let n = parseFloat(String(bid.amount || "").replace(/[^0-9.]/g, ""));

                if (!isNaN(n)) {
                    total += n;
                    parsed++;
                }
            });

            if (parsed > 0) {
                blockAmount = String(Math.round(total * 100) / 100);
            } else if (bids.length) {
                blockAmount = bids[0].amount || "";
            }
        }

        paint("el_txt_245_txtcnt", blockAmount);
        paint("el_txt_249_txtcnt", apz.app.applyPriority);
    } else if (from === "Withdraw") {
        let app = apz.app.selectedApplication || {};
        let wd = apz.app.withdrawData || {};

        apz.app.CommonSuccessScreen.showOnly("WithdrawDiv", "WithdrawFooterDiv");

        // Shared header: Request ID / Initiated Date & Time.
        paint("el_txt_218_txtcnt", wd.requestId);
        paint("el_txt_220_txtcnt", wd.initiatedDateTime);

        // NOTE: the entry carries an application record (no applicant
        // fields), so applicant cells stay blank until applicant
        // context rides along.
        paint("el_txt_255_txtcnt", "");
        paint("el_txt_256_txtcnt", app["IPO Details"]);
        paint("el_txt_257_txtcnt", app["Application ID"]);
        paint("el_txt_258_txtcnt", app["BID Amount"]);

        // Block Amount.
        paint("el_txt_260_txtcnt", app["BID Amount"]);
    } else if (from === "EditedApplicantReview") {
        let data = apz.app.editData || {};

        apz.app.CommonSuccessScreen.showOnly("EditSuccessDiv", "EditSuccessFooterDiv");

        // Shared header: Request ID / Approved timestamp.
        paint("el_txt_218_txtcnt", data.requestId);
        paint("el_txt_220_txtcnt", data.approvedDateTime);

        // Applicant ID / Nickname / Applicant Name.
        paint("el_txt_269_txtcnt", data.applicantId);
        paint("el_txt_270_txtcnt", data.nickname);
        paint("el_txt_271_txtcnt", data.applicantName);

        // Depository Type / DP ID / Client ID.
        paint("el_txt_275_txtcnt", data.depositoryType);
        paint("el_txt_276_txtcnt", data.dpId);
        paint("el_txt_277_txtcnt", data.clientId);

        // PAN.
        paint("el_txt_279_txtcnt", data.pan);

        // Priority.
        paint("el_txt_286_txtcnt", data.priority);
    } else if (from === "CheckerRegistrationCheck" || from === "CheckerAddApplicantSuccess") {
        let req = apz.app.checkerDecision || {};

        apz.app.CommonSuccessScreen.showOnly("CheckerAddapplicantSuccesspageDiv", "CheckerAddapplicantSuccesspageFooterDiv");

        // Shared header: Request ID / Initiated Date & Time.
        paint("el_txt_218_txtcnt", req.requestId);
        paint("el_txt_220_txtcnt", req.initiatedDateTime);

        // Nickname / Applicant Name / PAN.
        paint("el_txt_325_txtcnt", req.nickname);
        paint("el_txt_326_txtcnt", req.applicantName);
        paint("el_txt_327_txtcnt", req.pan);

        // Depository Type / DP ID / Client ID.
        paint("el_txt_331_txtcnt", req.depositoryType);
        paint("el_txt_332_txtcnt", req.dpId);
        paint("el_txt_333_txtcnt", req.clientId);

        // Priority.
        paint("el_txt_336_txtcnt", req.priority);
    } else if (from === "CheckerIPOcheck") {
        let req = apz.app.checkerDecision || {};
        let bids = req.bids || [];
        let firstBid = bids.length ? bids[0] : {};

        apz.app.CommonSuccessScreen.showOnly("CheckerIPOsuccespageDiv", "CheckerIPOsuccespageFooterDiv");

        // Shared header: Request ID / Initiated Date & Time.
        paint("el_txt_218_txtcnt", req.requestId);
        paint("el_txt_220_txtcnt", req.initiatedDateTime);

        // Nickname / Applicant Name / PAN.
        paint("el_txt_289_txtcnt", req.nickname);
        paint("el_txt_291_txtcnt", req.applicantName);
        paint("el_txt_293_txtcnt", req.pan);

        // Depository Type / DP ID / Client ID.
        paint("el_txt_295_txtcnt", req.depositoryType);
        paint("el_txt_297_txtcnt", req.dpId);
        paint("el_txt_299_txtcnt", req.clientId);

        // Investor Type / Debit Account / IPO Name.
        paint("el_txt_301_txtcnt", req.investorType);
        paint("el_txt_303_txtcnt", req.debitAccount);
        paint("el_txt_305_txtcnt", req.ipoName);

        // First bid row (No / Quantity / Price / Amount).
        paint("el_txt_311_txtcnt", firstBid.no);
        paint("el_txt_312_txtcnt", firstBid.quantity);
        paint("el_txt_313_txtcnt", firstBid.price);
        paint("el_txt_314_txtcnt", firstBid.amount);

        // Block Amount + Priority.
        paint("el_txt_316_txtcnt", req.blockAmount);
        paint("el_txt_317_txtcnt", req.blockAmount);
        paint("el_txt_320_txtcnt", req.priority);
    } else {
        // Unknown entry: show the registration block as a safe default.
        apz.app.CommonSuccessScreen.showOnly("ASBARegistrationDiv", "ASBARegistrationFooterDiv");
    }
};
