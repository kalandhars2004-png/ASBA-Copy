// ==============================
// CHECKER - IPO APPLY REQUESTS
// Screen: CheckerIPOcheck | Layout: NewLayout
// Static pending queue at script level (no interface on this
// screen). Checker verifies the IPO request + bids, writes
// remarks, then Accept (optional remarks) or Reject (remarks
// mandatory).
// All element IDs below are design IDs - do NOT rename them here.
// ==============================

// DOM id prefix for every element on this screen.
const CIC_P = "ASBA__CheckerIPOcheck__";

// Static IPO-request queue. Shared via apz.app so result pages
// see the same rows.
function checkerIPOQueueSeed() {
    return [
        {
            requestId: "ASBA-20250812-200001",
            initiatedDateTime: "12-08-2025 10:00:00",
            applicationId: "APP1001",
            approvedDateTime: "",
            nickname: "KDX",
            applicantName: "Kalandhar Mohamed",
            pan: "ABCDE1234F",
            depositoryType: "NSDL",
            dpId: "IN300001",
            clientId: "12345678",
            investorType: "Individual",
            debitAccount: "1870 2100 123456",
            ipoName: "Varun Beverages Limited",
            bids: [
                { no: "1", quantity: "70", price: "195", amount: "13650" }
            ],
            blockAmount: "13650",
            priority: "High",
            status: "PENDING",
            remarks: "",
            decidedOn: ""
        },
        {
            requestId: "ASBA-20250813-200002",
            initiatedDateTime: "13-08-2025 11:30:00",
            applicationId: "APP1002",
            approvedDateTime: "",
            nickname: "VINO",
            applicantName: "Vino Kumar",
            pan: "BCDEF2345G",
            depositoryType: "CDSL",
            dpId: "",
            clientId: "87654321",
            investorType: "Individual",
            debitAccount: "1870 2100 654321",
            ipoName: "Ather Energy Private Ltd",
            bids: [
                { no: "1", quantity: "100", price: "350", amount: "35000" }
            ],
            blockAmount: "35000",
            priority: "Medium",
            status: "PENDING",
            remarks: "",
            decidedOn: ""
        }
    ];
}

apz.app.CheckerIPOcheck = {

    // Pending queue (seeded once, shared across checker screens).
    queue: () => {
        if (!apz.app.checkerIPOQueue) {
            apz.app.checkerIPOQueue = checkerIPOQueueSeed();
        }

        return apz.app.checkerIPOQueue;
    },

    // Request currently under verification (first PENDING row).
    current: () => {
        let rows = apz.app.CheckerIPOcheck.queue();

        for (let i = 0; i < rows.length; i++) {
            if (rows[i].status === "PENDING") {
                return rows[i];
            }
        }

        return null;
    },

    // Checker remarks typed on this screen.
    remarks: () => {
        let elm = document.getElementById(CIC_P + "el_inp_2");
        return elm ? (elm.value || "").trim() : "";
    },

    // Records the decision, snapshots it for the result pages,
    // confirms with a message, then navigates.
    decide: (status, target) => {
        let req = apz.app.CheckerIPOcheck.current();

        if (!req) {
            apz.dispMsg({
                type: "E",
                message: "No pending request to decide"
            });
            return;
        }

        let remarks = apz.app.CheckerIPOcheck.remarks();

        // Remarks are mandatory on Reject (audit trail).
        if (status === "REJECTED" && !remarks) {
            apz.dispMsg({
                type: "E",
                message: "Remarks are mandatory to reject"
            });
            return;
        }

        req.status = status;
        req.remarks = remarks;
        req.decidedOn = apz.app.CheckerIPOcheck.now();

        // On accept the approval timestamp doubles as decided time.
        if (status === "ACCEPTED") {
            req.approvedDateTime = req.decidedOn;
        }

        // Snapshot for the success / reject pages.
        apz.app.checkerDecision = { ...req };

        apz.dispMsg({
            type: status === "ACCEPTED" ? "S" : "I",
            message: status === "ACCEPTED" ?
                "Request accepted" + (remarks ? " - " + remarks : "") :
                "Request rejected - " + remarks
        });

        apz.launchScreen({ appId: apz.appId, scr: target });
    },

    Reject: () => {
        apz.app.CheckerIPOcheck.decide("REJECTED", "CheckerIPOReject");
    },

    Accept: () => {
        apz.app.CheckerIPOcheck.decide("ACCEPTED", "CheckerIPOsuccespage");
    },

    now: () => {
        let d = new Date();
        let pad = (n) => String(n).padStart(2, "0");

        return pad(d.getDate()) + "-" + pad(d.getMonth() + 1) +
            "-" + d.getFullYear() + " " + pad(d.getHours()) +
            ":" + pad(d.getMinutes()) + ":" + pad(d.getSeconds());
    }
};


// ==============================
// ONLOAD - paints the pending IPO request under verification.
// Cell order matches the design labels.
// ==============================

apz.app.onLoad_CheckerIPOcheck = () => {

    let req = apz.app.CheckerIPOcheck.current();

    if (!req) {
        apz.dispMsg({
            type: "I",
            message: "No pending IPO requests"
        });
        return;
    }

    let paint = (id, value) => {
        let elm = document.getElementById(CIC_P + id);
        if (elm) {
            elm.textContent = (value === undefined || value === null) ? "" : String(value);
        }
    };

    // Request ID / Initiated Date & Time.
    paint("el_txt_66_txtcnt", req.requestId);
    paint("el_txt_68_txtcnt", req.initiatedDateTime);

    // Nickname / Applicant Name / PAN.
    paint("el_txt_71_txtcnt", req.nickname);
    paint("el_txt_73_txtcnt", req.applicantName);
    paint("el_txt_75_txtcnt", req.pan);

    // Depository Type / DP ID / Client ID.
    paint("el_txt_77_txtcnt", req.depositoryType);
    paint("el_txt_79_txtcnt", req.dpId);
    paint("el_txt_81_txtcnt", req.clientId);

    // Investor Type / Debit Account / IPO Name.
    paint("el_txt_83_txtcnt", req.investorType);
    paint("el_txt_85_txtcnt", req.debitAccount);
    paint("el_txt_87_txtcnt", req.ipoName);

    // First bid row (No / Quantity / Price / Amount).
    let bids = req.bids || [];
    let firstBid = bids.length ? bids[0] : {};

    paint("el_txt_93_txtcnt", firstBid.no);
    paint("el_txt_94_txtcnt", firstBid.quantity);
    paint("el_txt_95_txtcnt", firstBid.price);
    paint("el_txt_96_txtcnt", firstBid.amount);

    // Block Amount (both amount cells) + Priority.
    paint("el_txt_98_txtcnt", req.blockAmount);
    paint("el_txt_99_txtcnt", req.blockAmount);
    paint("el_txt_102_txtcnt", req.priority);
};
