// ==============================
// ADD APPLICANT SUCCESS
// Screen: AddApplicantSuccess | Layout: NewLayout
// All element IDs below are design IDs - do NOT rename them here.
// To change an ID, change it in the designer (D0.apzlayoutdesign)
// and rebuild; script-only changes must reuse the same IDs.
// ==============================

// DOM id prefix for every element on this screen.
const AAS_P = "ASBA__AddApplicantSuccess__";

apz.app.AddApplicantSuccess = {

    // Back to the dashboard (flow ends here).
    Dashboard: () => {
        apz.launchScreen({ appId: apz.appId, scr: "dashboard" });
    },

    // Starts a fresh IPO application for the new applicant.
    ApplyNewIPO: () => {
        apz.launchScreen({ appId: apz.appId, scr: "ApplyPage" });
    }
};


// ==============================
// ONLOAD - paints the success values from the shared
// apz.app.applicationData (request id + timestamp were
// frozen by confirm() on the Review screen).
// ==============================

apz.app.onLoad_AddApplicantSuccess = () => {

    // A new applicant now exists, so the user counts as
    // registered: the dashboard shows the dashboard view
    // (not the register block) on next visit. Stored on
    // apz.app so it survives screen script reloads.
    if (true) {
        apz.app.isRegistered = true;
    }

    let data = apz.app.applicationData;

    if (!data) {
        return;
    }

    let paint = (id, value) => {
        let elm = document.getElementById(AAS_P + id);
        if (elm) {
            elm.textContent = value || "";
        }
    };

    // Request ID / Initiated Date & Time
    paint("el_txt_63_txtcnt", data.requestId);
    paint("el_txt_65_txtcnt", data.initiatedDateTime);

    // Nickname / Applicant Name / Client ID (CIF ID)
    paint("el_txt_103_txtcnt", data.nickname);
    paint("el_txt_104_txtcnt", data.applicantName);
    paint("el_txt_105_txtcnt", data.clientId);

    // Depository Type / DP ID / Client ID
    paint("el_txt_115_txtcnt", data.depositoryType);
    paint("el_txt_116_txtcnt", data.dpId);
    paint("el_txt_117_txtcnt", data.clientId);

    // Priority
    paint("el_txt_81_txtcnt", data.priority);
};
