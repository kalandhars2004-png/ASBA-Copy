// ==============================
// CHECKER - APPLICANT ACCEPTED PAGE
// Screen: CheckerAddapplicantSuccesspage | Layout: NewLayout
// Paints the decided request snapshot (apz.app.checkerDecision)
// written by the Accept action.
// All element IDs below are design IDs - do NOT rename them here.
// ==============================

// DOM id prefix for every element on this screen.
const CAP_P = "ASBA__CheckerAddapplicantSuccesspage__";

apz.app.CheckerAddapplicantSuccesspage = {

    // Back to the dashboard (flow ends here).
    Dashboard: () => {
        apz.launchScreen({ appId: apz.appId, scr: "dashboard" });
    },

    // Starts a fresh IPO application.
    AddNewIPO: () => {
        apz.launchScreen({ appId: apz.appId, scr: "ApplyPage" });
    }
};


// ==============================
// ONLOAD - paints the accepted request snapshot.
// ==============================

apz.app.onLoad_CheckerAddapplicantSuccesspage = () => {

    // Static sample so the page shows data even when opened
    // directly (no Accept/Reject ran yet in this session).
    let req = apz.app.checkerDecision || {
        requestId: "ASBA-20250812-100001",
        initiatedDateTime: "12-08-2025 10:00:00",
        nickname: "KDX",
        applicantName: "Kalandhar Mohamed",
        pan: "ABCDE1234F",
        depositoryType: "NSDL",
        dpId: "IN300001",
        clientId: "12345678",
        priority: "High"
    };

    let paint = (id, value) => {
        let elm = document.getElementById(CAP_P + id);
        if (elm) {
            elm.textContent = (value === undefined || value === null) ? "" : String(value);
        }
    };

    // Request ID / Initiated Date & Time.
    paint("el_txt_4_txtcnt", req.requestId);
    paint("el_txt_6_txtcnt", req.initiatedDateTime);

    // Nickname / Applicant Name / PAN.
    paint("el_txt_11_txtcnt", req.nickname);
    paint("el_txt_12_txtcnt", req.applicantName);
    paint("el_txt_13_txtcnt", req.pan);

    // Depository Type / DP ID / Client ID.
    paint("el_txt_23_txtcnt", req.depositoryType);
    paint("el_txt_24_txtcnt", req.dpId);
    paint("el_txt_25_txtcnt", req.clientId);

    // Priority.
    paint("el_txt_28_txtcnt", req.priority);
};
