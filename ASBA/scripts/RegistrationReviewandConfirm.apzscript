// ==============================
// REGISTRATION REVIEW + CONFIRM
// Screen: RegistrationReviewandConfirm | Layout: NewLayout
// All element IDs below are design IDs - do NOT rename them here.
// To change an ID, change it in the designer (D0.apzlayoutdesign)
// and rebuild; script-only changes must reuse the same IDs.
// ==============================

// DOM id prefix for every element on this screen.
const RRC_P = "ASBA__RegistrationReviewandConfirm__";

apz.app.RegistrationReviewandConfirm = {

    // Back to the form. Entered data stays in
    // apz.app.registrationData for re-paint on return.
    edit: () => {
        apz.launchScreen({ appId: apz.appId, scr: "RegisterApplicant" });
    },

    confirm: () => {
        apz.launchScreen({ appId: apz.appId, scr: "RegistrationSuccespage" });
    }
};


// ==============================
// ONLOAD - paints the review values from the shared
// apz.app.registrationData collected on the form screen.
// Cell order matches the design labels:
// Nickname / Applicant Name / CIF ID, then
// Corporate ID / Corporate Name / PAN, then
// Depository Type / DP ID / Client ID, then Priority.
// ==============================

apz.app.onLoad_RegistrationReviewandConfirm = () => {

    let data = apz.app.registrationData;

    if (!data) {
        return;
    }

    let paint = (id, value) => {
        let elm = document.getElementById(RRC_P + id);
        if (elm) {
            elm.textContent = value || "";
        }
    };

    // Nickname / Applicant Name / CIF ID
    paint("el_txt_19_txtcnt", data.nickname);
    paint("el_txt_22_txtcnt", data.applicantName);
    paint("el_txt_25_txtcnt", data.cifId || data.clientId);

    // Corporate ID / Corporate Name / PAN
    paint("el_txt_20_txtcnt", data.corporateId);
    paint("el_txt_23_txtcnt", data.corporateName);
    paint("el_txt_26_txtcnt", data.pan);

    // Depository Type / DP ID / Client ID
    paint("el_txt_21_txtcnt", data.depositoryType);
    paint("el_txt_24_txtcnt", data.dpId);
    paint("el_txt_27_txtcnt", data.clientId);

    // Priority
    paint("el_txt_15_txtcnt", data.priority);

    // CDSL applicants have no DP ID - hide its label + value.
    if ((data.depositoryType || "") === "CDSL") {
        apz.hide(RRC_P + "el_txt_17");
        apz.hide(RRC_P + "el_txt_24");
    }
};
