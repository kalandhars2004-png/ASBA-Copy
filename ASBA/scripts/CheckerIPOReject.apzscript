// ==============================
// CHECKER - IPO REJECTED PAGE
// Screen: CheckerIPOReject | Layout: NewLayout
// Paints the decided IPO request snapshot
// (apz.app.checkerDecision) written by the Reject action
// (remarks were mandatory there).
// All element IDs below are design IDs - do NOT rename them here.
// ==============================

// DOM id prefix for every element on this screen.
const CIR_P = "ASBA__CheckerIPOReject__";

apz.app.CheckerIPOReject = {

    // Back to the dashboard (flow ends here).
    Dashboard: () => {
        apz.launchScreen({ appId: apz.appId, scr: "dashboard" });
    }
};


// ==============================
// ONLOAD - paints the rejected IPO request snapshot.
// ==============================

apz.app.onLoad_CheckerIPOReject = () => {

    let req = apz.app.checkerDecision;

    if (!req) {
        return;
    }

    let paint = (id, value) => {
        let elm = document.getElementById(CIR_P + id);
        if (elm) {
            elm.textContent = (value === undefined || value === null) ? "" : String(value);
        }
    };

    // Request ID / Application ID / Decided Date & Time.
    paint("el_txt_4_txtcnt", req.requestId);
    paint("el_txt_6_txtcnt", req.applicationId);
    paint("el_txt_8_txtcnt", req.decidedOn || req.initiatedDateTime);

    // Applicant ID (none on record) / Nickname / Applicant Name.
    paint("el_txt_11_txtcnt", "");
    paint("el_txt_13_txtcnt", req.nickname);
    paint("el_txt_15_txtcnt", req.applicantName);

    // Depository Type / DP ID / Client ID.
    paint("el_txt_17_txtcnt", req.depositoryType);
    paint("el_txt_19_txtcnt", req.dpId);
    paint("el_txt_21_txtcnt", req.clientId);

    // Investor Type / Debit Account / IPO Name.
    paint("el_txt_23_txtcnt", req.investorType);
    paint("el_txt_25_txtcnt", req.debitAccount);
    paint("el_txt_27_txtcnt", req.ipoName);

    // First bid row (No / Quantity / Price / Amount).
    let bids = req.bids || [];
    let firstBid = bids.length ? bids[0] : {};

    paint("el_txt_33_txtcnt", firstBid.no);
    paint("el_txt_34_txtcnt", firstBid.quantity);
    paint("el_txt_35_txtcnt", firstBid.price);
    paint("el_txt_36_txtcnt", firstBid.amount);

    // Block Amount (both amount cells) + Priority.
    paint("el_txt_38_txtcnt", req.blockAmount);
    paint("el_txt_39_txtcnt", req.blockAmount);
    paint("el_txt_42_txtcnt", req.priority);
};
